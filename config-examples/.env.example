# SOC Automation 2.0 - n8n Docker environment example
# Copy this file to .env for local use and replace placeholder values.
# Never commit the live .env file.

# Container image used during the lab
N8N_IMAGE=n8nio/n8n:1.119.2

# n8n network settings
N8N_HOST=YOUR_N8N_HOST_OR_IP
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://YOUR_N8N_HOST_OR_IP:5678/

# Timezone settings used by n8n and scheduled workflows
GENERIC_TIMEZONE=America/Toronto
TZ=America/Toronto

# Local lab setting only. Use HTTPS and set this to true in production.
N8N_SECURE_COOKIE=false

# Local directory used to persist n8n data across container restarts
N8N_DATA_PATH=./n8n_data

# API keys and passwords are intentionally excluded.
# Configure OpenAI, Slack, VirusTotal, AbuseIPDB, and DFIR-IRIS
# through n8n's credential manager rather than storing them here.
