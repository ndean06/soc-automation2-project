{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOC Triage Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_summary",
    "severity",
    "confidence",
    "observed_facts",
    "assessment",
    "mitre_attack",
    "enrichment",
    "evidence_gaps",
    "recommended_next_steps",
    "escalation_recommended"
  ],
  "properties": {
    "alert_summary": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["informational", "low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "observed_facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assessment": { "type": "string" },
    "mitre_attack": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tactic", "technique_id", "technique", "justification"],
        "properties": {
          "tactic": { "type": "string" },
          "technique_id": { "type": "string" },
          "technique": { "type": "string" },
          "justification": { "type": "string" }
        }
      }
    },
    "enrichment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalation_recommended": { "type": "boolean" }
  }
}
